# Local Supabase — run `supabase start` and copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key-here>

# Used to build the email confirmation link (signUp's emailRedirectTo).
# Optional on Vercel — it auto-detects your deployment URL. Set this to
# override with a custom domain, or when deploying somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
